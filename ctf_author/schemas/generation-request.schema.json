{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "challenge_version": {
      "type": "integer",
      "minimum": 1
    },
    "flag": {
      "type": "string",
      "pattern": "^[!-~]{1,512}$"
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "challenge_id",
    "challenge_version",
    "flag",
    "seed",
    "output_dir",
    "parameters"
  ]
}
