{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "challenge_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "private_dir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  },
  "required": [
    "schema_version",
    "challenge_id",
    "challenge_version",
    "seed",
    "output_dir",
    "private_dir"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}