{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strip": {
          "type": "boolean"
        },
        "casefold": {
          "type": "boolean"
        }
      },
      "required": [
        "strip",
        "casefold"
      ]
    }
  },
  "required": [
    "schema_version",
    "answer",
    "comparison"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}